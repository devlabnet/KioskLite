#!/bin/sh

# Disable screen blanking.
xset s off
xset s noblank
xset -dpms

# Hide the mouse pointer.
unclutter -idle 1 -root &

# Start the window manager.
openbox-session &
sleep 1

# Load display configuration.
. "$HOME/kiosk.conf"

# Read the kiosk URL.
CONFIG="/boot/firmware/kiosklite.conf"
ERROR_PAGE="file:///usr/local/share/kiosklite/config-error.html"
URL=""

if [ -r "$CONFIG" ]; then
    URL=$(sed -n \
        's/^[[:space:]]*URL[[:space:]]*=[[:space:]]*//p' \
        "$CONFIG" | head -n 1)
fi

URL=$(printf '%s' "$URL" | tr -d '\r')

case "$URL" in
    http://*|https://*)
        KIOSK_URL="$URL"
        ;;
    *)
        KIOSK_URL="$ERROR_PAGE"
        ;;
esac

# Start Midori and restart it if it exits.
while true
do
    ALSOFT_DRIVERS=null midori "$KIOSK_URL" \
        > /tmp/midori-debug.log 2>&1 &

    MIDORI_PID=$!

    # Wait up to 60 seconds for Midori and an active window.
    ATTEMPTS=0

    while kill -0 "$MIDORI_PID" 2>/dev/null &&
          [ "$ATTEMPTS" -lt 60 ]
    do
        WINDOW=$(xdotool search --onlyvisible \
            --class '[Mm]idori' 2>/dev/null | head -n 1)

        ACTIVE=$(xdotool getactivewindow 2>/dev/null)

        if [ -n "$WINDOW" ] &&
           [ -n "$ACTIVE" ] &&
           [ "$ACTIVE" != "0" ]; then

            sleep 2

            # Activate Midori before sending F11.
            if timeout 5 xdotool windowactivate --sync "$WINDOW"
            then
                xdotool key --clearmodifiers F11
            fi

            break
        fi

        sleep 1
        ATTEMPTS=$((ATTEMPTS + 1))
    done

    # Keep the session alive until Midori exits.
    wait "$MIDORI_PID"
    sleep 5
done